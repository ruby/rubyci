<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=Edge,chrome=1">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= content_for?(:title) ? yield(:title) : "RubyCI" %></title>
    <%= csrf_meta_tags %>
    <!-- For all other devices -->
    <!-- Size should be 32 x 32 pixels -->
    <%= favicon_link_tag 'favicon.ico', :rel => 'shortcut icon' %>
    <%= stylesheet_link_tag "application", :media => "all" %>
  </head>
  <body>

    <nav class="navbar">
      <div class="container-fluid">
        <a class="navbar-brand" href="/">Ruby CI</a>
        <ul class="navbar-nav">
          <li class="nav-item"><%= link_to "Current Reports", "/reports", class: "nav-link" %></li>
          <li class="nav-item"><%= link_to "Latest Reports", "/", class: "nav-link" %></li>
          <li class="nav-item"><%= link_to "Search", "/search", class: "nav-link" %></li>
        </ul>
      </div>
    </nav>

    <div class="container-fluid">
      <div class="content">
        <!-- app/views/reports/index.html.erb -->
        <%= yield %>

        <div class="alert alert-info">
          <div>
            F: <span class="badge text-bg-danger">failure</span>
            E: <span class="badge text-bg-danger">error</span>
            S: <span class="badge text-bg-info">skip</span>
            failed: <span class="badge text-bg-danger">critical failures</span>
          </div>
          <div>
            see also <a href="https://rubyci.org/coverage">Code coverage report</a>,
            <a href="http://ci.rvm.jp/">ci.rvm.jp</a>,
            and <a href="http://www.narihiro.info/crubybenci/">CRuby Benchmark CI</a>.
          </div>
        </div>

      </div><!--/content-->

      <footer>
        <p>
          Powered by
          <%= link_to "chkbuild", "https://github.com/akr/chkbuild" %> and
          <%= link_to "rubyci", "https://github.com/nurse/rubyci" %>.
        </p>
        <p>
          Ruby CI is supported by
          <%= link_to "these sponsors", "https://www.ruby-lang.org/en/about/website/" %>
        </p>
        <p>
          Working with <%= RUBY_DESCRIPTION %>
        </p>
      </footer>

    </div> <!-- /container -->
  </body>
</html>
